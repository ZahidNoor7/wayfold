# Wayfold environment: infrastructure only.
#
# Tenant integrations (Cloudinary, SMTP, Stripe, Google Maps, WhatsApp) are
# NOT configured here. Each workspace connects its own under
# Settings → Integrations; credentials are stored encrypted in the database
# and take effect immediately, with no redeploy.

# --- Database (Neon PostgreSQL) ---------------------------------------------
# Runtime connection. Must be a role that is a member of `wayfold_app`,
# with no superuser and no BYPASSRLS. The app refuses to start otherwise.
DATABASE_URL=postgres://wf_app:CHANGE_ME@HOST/wayfold?sslmode=require
# Platform-administration connection: a member of `wayfold_platform`.
DATABASE_PLATFORM_URL=postgres://wf_platform:CHANGE_ME@HOST/wayfold?sslmode=require
# Schema owner. Used only by `pnpm db:migrate`; do not set it on the web app.
DATABASE_MIGRATION_URL=postgres://owner:CHANGE_ME@HOST/wayfold?sslmode=require
# `neon` (WebSocket pool, production) or `pg` (node-postgres, local and CI).
DATABASE_DRIVER=neon
DATABASE_POOL_MAX=5

# --- Hosts -------------------------------------------------------------------
# Tenants are served at {slug}.ROOT_DOMAIN; the dashboard at APP_HOST.
ROOT_DOMAIN=wayfold.com
APP_HOST=app.wayfold.com
APP_URL=https://app.wayfold.com

# --- Secrets -----------------------------------------------------------------
# Keys session and token hashes. 48+ random bytes:  openssl rand -base64 48
SESSION_SECRET=CHANGE_ME
# Master keys for tenant credential encryption (AES-256-GCM).
# Format: v1:<base64 of 32 bytes>[,v2:<...>]   Generate: openssl rand -base64 32
# Keep old versions listed while rotating; see docs/operations/key-rotation.md
CREDENTIAL_ENCRYPTION_KEYS=v1:CHANGE_ME
CREDENTIAL_ENCRYPTION_ACTIVE_KEY=v1
# Shared secret for scheduled jobs (/api/cron/*):  openssl rand -base64 32
CRON_SECRET=CHANGE_ME
